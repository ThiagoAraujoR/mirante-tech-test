# =============================================================
# LLM
# =============================================================
# AVISO: este projeto é uma POC (Prova de Conceito).
# As chaves abaixo NÃO são fornecidas pelo projeto — cada usuário deve usar
# AS SUAS PRÓPRIAS chaves de API do provedor escolhido. Caso seja necessário
# utilizar uma ferramenta/modelo mais poderoso (tier superior, modelos de
# raciocínio estendido, modelos especializados em código), adicione aqui
# a sua chave de API correspondente. Custos de inferência são por conta
# do usuário.
LLM_PROVIDER=anthropic               # anthropic | openai | gemini
LLM_MODEL=claude-opus-4-7
# Para Gemini, defaults: gemini-2.5-pro (qualidade) ou gemini-2.5-flash (custo).
# Para OpenAI, defaults: gpt-4o.
# Para casos mais exigentes, considere modelos de tier superior do provedor escolhido.
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=8192

# Substitua os placeholders abaixo pelas SUAS PRÓPRIAS chaves de API.
ANTHROPIC_API_KEY=sk-ant-...         # sua chave Anthropic (https://console.anthropic.com/)
OPENAI_API_KEY=sk-...                # sua chave OpenAI (https://platform.openai.com/api-keys)
GOOGLE_API_KEY=...                   # sua chave Google AI Studio (https://aistudio.google.com/app/apikey)

# =============================================================
# Banco principal (persistência da pipeline)
# =============================================================
APP_POSTGRES_USER=mirante
APP_POSTGRES_PASSWORD=mirante
APP_POSTGRES_DB=mirante
DATABASE_URL=postgresql+asyncpg://mirante:mirante@postgres-app:5432/mirante

# =============================================================
# Banco sandbox (validação dinâmica do código gerado)
# =============================================================
SANDBOX_POSTGRES_USER=sandbox
SANDBOX_POSTGRES_PASSWORD=sandbox
SANDBOX_POSTGRES_DB=sandbox
SANDBOX_DATABASE_URL=postgresql+psycopg://sandbox:sandbox@postgres-sandbox:5432/sandbox

# =============================================================
# Langfuse (observabilidade)
# =============================================================
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=http://langfuse-web:3000
# Chave hex de 64 caracteres usada pelo Langfuse self-hosted (web + worker).
# Gere com: openssl rand -hex 32
LANGFUSE_ENCRYPTION_KEY=

# =============================================================
# Pipeline
# =============================================================
MAX_GENERATE_ATTEMPTS=2
ENABLE_DYNAMIC_VALIDATION=true

# =============================================================
# Results em disco
# =============================================================
# Diretório onde cada run materializa generated.py, report.json e decisions.md.
# Dentro do container, /results é montado em ./results no host via docker-compose.
# É CRÍTICO que este path fique FORA de /app — caso contrário o hot-reload do
# `langgraph dev` reinicia o servidor a cada arquivo gerado pelo nó persist.
RESULTS_DIR=/results
WRITE_RESULTS_TO_DISK=true
